# Copy this file to .env only when credentials are needed.
# Never grant withdrawal permission to the exchange API key.
FREQTRADE_IMAGE=freqtradeorg/freqtrade:stable
# This is a second safety lock in addition to config.json.
FREQTRADE__DRY_RUN=true
FREQTRADE__EXCHANGE__API_KEY=
FREQTRADE__EXCHANGE__SECRET=
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=
