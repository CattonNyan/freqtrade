# ==========================================
# Freqtrade Environment Variables Template
# Copy this file to .env and fill in your values
# ==========================================

# Exchange API Credentials
FREQTRADE__EXCHANGE__NAME=binance
FREQTRADE__EXCHANGE__KEY=your_exchange_api_key_here
FREQTRADE__EXCHANGE__SECRET=your_exchange_api_secret_here
FREQTRADE__EXCHANGE__PASSWORD=your_exchange_api_password_if_required

# FreqUI / REST API Server
FREQTRADE__API_SERVER__LISTEN_PORT=8080
FREQTRADE__API_SERVER__USERNAME=freqtrader
FREQTRADE__API_SERVER__PASSWORD=ChangeMeStrongPassword123
FREQTRADE__API_SERVER__JWT_SECRET_KEY=change_this_to_a_random_secure_hex_key

# Telegram Notifications (Optional)
FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=your_telegram_bot_token_here
FREQTRADE__TELEGRAM__CHAT_ID=your_telegram_chat_id_here

# Dry-run or Live Trading
FREQTRADE__DRY_RUN=true
FREQTRADE__DRY_RUN_WALLET=1000
