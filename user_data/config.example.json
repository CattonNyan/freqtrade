{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "bot_name": "freqtrade-dryrun",
    "initial_state": "running",
    "dry_run": true,
    "dry_run_wallet": 10000,
    "trading_mode": "spot",
    "margin_mode": "",
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": 100,
    "tradable_balance_ratio": 0.95,
    "fiat_display_currency": "USD",
    "timeframe": "15m",
    "strategy": "KoreanStarterStrategy",
    "cancel_open_orders_on_exit": true,
    "force_entry_enable": false,
    "unfilledtimeout": {
        "entry": 5,
        "exit": 5,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "binance",
        "api_key": "",
        "secret": "",
        "ccxt_config": {
            "enableRateLimit": true
        },
        "ccxt_async_config": {
            "enableRateLimit": true
        },
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT",
            "BNB/USDT",
            "SOL/USDT",
            "XRP/USDT"
        ],
        "pair_blacklist": [
            ".*(UP|DOWN|BULL|BEAR)/USDT",
            "USDC/USDT",
            "FDUSD/USDT"
        ]
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": ""
    },
    "api_server": {
        "enabled": false,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "replace-before-enabling-api-server",
        "ws_token": "replace-before-enabling-api-server",
        "CORS_origins": [],
        "username": "freqtrader",
        "password": "replace-before-enabling-api-server"
    },
    "internals": {
        "process_throttle_secs": 5,
        "heartbeat_interval": 60
    },
    "dataformat_ohlcv": "feather",
    "dataformat_trades": "feather"
}
